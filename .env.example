# ─── Vertex AI — Gemini 2.5 Flash (required) ────────────────────────────────
# Used for all frame analysis. Credits are consumed from your GCP project.
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# Path to a GCP service account JSON key file.
# Local: set this if you don't use `gcloud auth application-default login`
# Server: always required (mount the file into the container)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_key.json

# ─── Google Maps — Places API enrichment (optional) ─────────────────────────
# Adds rating, photos, hours, Maps URL to identified locations.
# Skip to reduce cost — Gemini already provides name + coordinates.
GOOGLE_MAPS_API_KEY=AIza...

# ─── Pipeline Tuning ────────────────────────────────────────────────────────
SCENE_DETECTION_THRESHOLD=27.0
SCENE_MIN_LENGTH_FRAMES=15
MAX_UNIQUE_FRAMES=10
MIN_VISION_CONFIDENCE=0.60
FRAME_MAX_DIMENSION=1024
FRAME_JPEG_QUALITY=85

# ─── Limits ─────────────────────────────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_SIZE_MB=200
MAX_LOCATIONS=20

# ─── Cache ───────────────────────────────────────────────────────────────────
PLACES_CACHE_DIR=/tmp/travbuddy/places_cache
PLACES_CACHE_TTL_SECONDS=604800

# ─── Job Queue ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── GCS — video/frame storage (optional) ────────────────────────────────────
GCS_BUCKET_NAME=

# ─── Supabase — job results (optional) ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
TEMP_DIR=/tmp/travbuddy
